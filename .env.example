# Copy to .env and enter credentials locally. Never commit .env.
# Backend credentials only; do not expose these in browser code.
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
HIYA_API_KEY=

# Gemini conversational speaker.
GEMINI_MODEL=gemini-3.8-live

# Hiya resources. Obtain your owner handle and enroll the speaker first.
# Use us or eu to match the region where your Hiya key was issued.
HIYA_REGION=us
HIYA_OWNER=
HIYA_SPACE=main
HIYA_IDENTITY=
HIYA_VOICEPRINT=

# digital for microphone audio; phone for telephone audio.
HIYA_AUTHENTICITY_MODEL=digital
