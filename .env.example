# Copy to .env before first launch. Never commit real credentials.
# Existing shell/process environment variables override this file.
# All keys stay on the backend. All four are required by the website setup check.
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
SONIOX_API_KEY=
HIYA_API_KEY=

# Gemini Live audio conversation and enrollment text use separate models.
# Override with compatible models available to your API project if necessary.
GEMINI_MODEL=gemini-3.8-live
GEMINI_ENROLLMENT_MODEL=gemini-3.8-flash

# Soniox live language identification. Requires funded organization/API access.
SONIOX_MODEL=stt-rt-v5

# Existing Hiya Audio Intelligence resources: user/organization handle + space.
# Local account registration creates identities/voiceprints, not this owner/space.
# Region must match the resources accessible to your key: us or eu.
HIYA_REGION=us
HIYA_OWNER=
HIYA_SPACE=main

# Optional standalone adapter defaults; leave blank for website enrollment/calls.
HIYA_IDENTITY=
HIYA_VOICEPRINT=

# Enrollment/standalone authenticity screening: digital for browser microphone audio.
# Setting phone does not enable telephone calls. Live identity uses its digital voiceprint.
HIYA_AUTHENTICITY_MODEL=digital
